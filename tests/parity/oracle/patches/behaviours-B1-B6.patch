@@ -5,9 +5,8 @@
 select
     -- Grouping dimensions
     coalesce(pickup_zone, 'Unknown Zone') as pickup_zone,
-    {% if target.type == 'bigquery' %}cast(date_trunc(pickup_datetime, month) as date)
-    {% elif target.type == 'duckdb' %}date_trunc('month', pickup_datetime)
-    {% endif %} as revenue_month,
+    -- B4: portable on every adapter (the original had no Databricks branch)
+    cast({{ dbt.date_trunc('month', 'pickup_datetime') }} as date) as revenue_month,
     service_type,
 
     -- Revenue breakdown (summed by zone, month, and service type)
@@ -22,8 +21,8 @@ select
 
     -- Additional metrics for operational analysis
     count(trip_id) as total_monthly_trips,
-    avg(passenger_count) as avg_monthly_passenger_count,
-    avg(trip_distance) as avg_monthly_trip_distance
+    cast(avg(passenger_count) as double) as avg_monthly_passenger_count,
+    cast(sum(trip_distance) as double) / count(trip_distance) as avg_monthly_trip_distance
 
 from {{ ref('fct_trips') }}
 group by pickup_zone, revenue_month, service_type
\ No newline at end of file
