diff --git a/04-analytics-engineering/taxi_rides_ny/models/marts/fct_trips.sql b/04-analytics-engineering/taxi_rides_ny/models/marts/fct_trips.sql
index 110828b..899b40e 100644
--- a/04-analytics-engineering/taxi_rides_ny/models/marts/fct_trips.sql
+++ b/04-analytics-engineering/taxi_rides_ny/models/marts/fct_trips.sql
@@ -1,3 +1,4 @@
+-- depends_on: {{ ref('int_trips_unioned') }}  -- B1: referenced only in the incremental branch
 {{
   config(
     materialized='incremental',
@@ -56,6 +57,13 @@ left join {{ ref('dim_zones') }} as dz
     on trips.dropoff_location_id = dz.location_id
 
 {% if is_incremental() %}
-  -- Only process new trips based on pickup datetime
-  where trips.pickup_datetime > (select max(pickup_datetime) from {{ this }})
+  -- B1: bounded high-water mark. Only pickups of earlier loads that fall inside
+  -- their own file month count, so a 2088 typo can no longer freeze the table.
+  -- Late trips (pickup <= HWM) are still dropped, as in the legacy pipeline.
+  where trips.pickup_datetime > (
+    select coalesce(max(u.pickup_datetime), cast('1900-01-01' as timestamp))
+    from {{ ref('int_trips_unioned') }} as u
+    where {{ file_month('u.filename') }} != '{{ var("batch_file_month") }}'
+      and substr(cast(u.pickup_datetime as {{ dbt.type_string() }}), 1, 7) = {{ file_month('u.filename') }}
+  )
 {% endif %}
diff --git a/04-analytics-engineering/taxi_rides_ny/models/marts/reporting/fct_monthly_zone_revenue.sql b/04-analytics-engineering/taxi_rides_ny/models/marts/reporting/fct_monthly_zone_revenue.sql
